<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  >

  <title>Voice Changer AI</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #05070d;
    }

    .wrapper {
      width: 100%;
      height: 100dvh;
      position: relative;
      overflow: hidden;
    }

    iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      outline: none;
    }

    /* Loading */
    .loading {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #05070d;
      color: #9cff00;
      font-family: Arial, sans-serif;
      font-size: 14px;
      transition: opacity .3s ease;
      pointer-events: none;
    }

    .loading.hidden {
      opacity: 0;
    }

    .loader {
      width: 32px;
      height: 32px;
      border: 3px solid rgba(156,255,0,.2);
      border-top-color: #9cff00;
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin-right: 10px;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>

<body>

  <div class="wrapper">

    <div class="loading" id="loading">
      <div class="loader"></div>
      Memuat aplikasi...
    </div>

    <iframe
      id="app"
      src="https://script.google.com/macros/s/AKfycbzNU1W_4-7dUnSLku3UopRVfrwcorZ4VaDY2Cd9a_I4M1SExTAywxGHMPm9iqlIgMHP/exec"
      allow="microphone; camera; geolocation; autoplay"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin">
    </iframe>

  </div>

  <script>
    const iframe = document.getElementById("app");
    const loading = document.getElementById("loading");

    iframe.addEventListener("load", () => {
      setTimeout(() => {
        loading.classList.add("hidden");
      }, 300);
    });
  </script>

</body>
</html>
